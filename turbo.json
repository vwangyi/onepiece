{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {},

    "//#pkg:build": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["*"]
    },

    "//#nest:dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },

    "//#pkg:dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#pkg:build"],
      "passThroughEnv": ["*"]
    },

    "//#vue:dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#pkg:build"],
      "passThroughEnv": ["*"]
    }
  }
}
